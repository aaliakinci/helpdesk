# Development-only template. Do not reuse these values in a public deployment.
NODE_ENV=development
APP_VERSION=0.0.0
API_PORT=8080
WORKER_HEALTH_PORT=8081
WEB_PORT=5173
WEB_ORIGIN=http://127.0.0.1:5173
TRUSTED_PROXY_HOPS=0
REQUEST_RATE_LIMIT=240
REQUEST_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=12
UPLOAD_TIMEOUT_MS=30000
WEBSOCKET_CONNECTION_LIMIT=30
WEBSOCKET_CONNECTION_WINDOW_SECONDS=60

ATTACHMENT_STORAGE_DRIVER=local
ATTACHMENT_LOCAL_DIRECTORY=/var/lib/helpdesk/attachments
ATTACHMENT_MAX_BYTES=5242880
# Production S3-compatible storage only:
# ATTACHMENT_S3_ENDPOINT=https://object-storage.example.test
# ATTACHMENT_S3_REGION=eu-central-1
# ATTACHMENT_S3_BUCKET=helpdesk-private
# ATTACHMENT_S3_ACCESS_KEY_ID=replace-me
# ATTACHMENT_S3_SECRET_ACCESS_KEY=replace-with-at-least-32-random-bytes
# ATTACHMENT_S3_FORCE_PATH_STYLE=true

POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=replace-with-local-development-password
DATABASE_URL=postgresql://helpdesk:replace-with-local-development-password@127.0.0.1:5432/helpdesk?schema=public
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=helpdesk
RABBITMQ_DEFAULT_PASS=replace-with-local-development-password
RABBITMQ_DEFAULT_VHOST=helpdesk
RABBITMQ_URL=amqp://helpdesk:replace-with-local-development-password@127.0.0.1:5672/helpdesk
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PREFETCH=8
MESSAGING_MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=25
OUTBOX_LEASE_SECONDS=30
OUTBOX_POLL_INTERVAL_MS=500

REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
REALTIME_AUTH_RECHECK_MS=5000
SLA_SCHEDULER_BATCH_SIZE=50
SLA_SCHEDULER_INTERVAL_MS=30000

VITE_API_BASE_URL=
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8080

ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_AUDIENCE=helpdesk-support-api
ACCESS_TOKEN_ISSUER=helpdesk
ACCESS_TOKEN_TTL_SECONDS=600
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=60
DEMO_SEED_PASSWORD=HelpdeskDemo-Local-2026!
REFRESH_COOKIE_NAME=helpdesk_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_SESSION_TTL_DAYS=7
