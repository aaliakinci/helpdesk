# Development-only template. Do not reuse these values in a public deployment.
NODE_ENV=development
API_PORT=8080
WEB_ORIGIN=http://127.0.0.1:5173

POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=replace-with-local-development-password
DATABASE_URL=postgresql://helpdesk:replace-with-local-development-password@127.0.0.1:5432/helpdesk?schema=public

RABBITMQ_DEFAULT_USER=helpdesk
RABBITMQ_DEFAULT_PASS=replace-with-local-development-password
RABBITMQ_DEFAULT_VHOST=helpdesk
RABBITMQ_URL=amqp://helpdesk:replace-with-local-development-password@127.0.0.1:5672/helpdesk

REDIS_URL=redis://127.0.0.1:6379

ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REFRESH_COOKIE_NAME=helpdesk_refresh
