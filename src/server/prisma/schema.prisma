generator client {
  provider     = "prisma-client"
  output       = "../platform/database/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TenantStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum TenantRole {
  OWNER
  MANAGER
  AGENT
  REQUESTER
  AUDITOR
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCommentVisibility {
  PUBLIC
  INTERNAL
}

enum OutboxMessageStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum NotificationDeliveryChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum QueueStatus {
  ACTIVE
  DISABLED
}

enum QueueMemberStatus {
  ACTIVE
  DISABLED
}

enum TicketAssignmentAction {
  QUEUED
  ASSIGNED
  UNASSIGNED
  TAKEN_OVER
  ROUND_ROBIN_ASSIGNED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum SlaMilestoneStatus {
  ACTIVE
  APPROACHING
  BREACHED
  COMPLETED
}

model PlatformMetadata {
  key       String   @id @db.VarChar(100)
  value     String   @db.VarChar(500)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_metadata")
}

model User {
  id                  String                 @id @default(uuid()) @db.Uuid
  email               String                 @unique(map: "users_email_key") @db.VarChar(254)
  displayName         String                 @map("display_name") @db.VarChar(120)
  passwordHash        String                 @map("password_hash") @db.VarChar(255)
  status              UserStatus             @default(ACTIVE)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships         TenantMembership[]
  sessions            UserSession[]
  contacts            CustomerContact[]
  identityAudit       IdentityAuditEntry[]   @relation("IdentityAuditActor")
  createdTickets      Ticket[]               @relation("TicketCreator")
  ticketComments      TicketComment[]        @relation("TicketCommentAuthor")
  ticketStatusHistory TicketStatusHistory[]  @relation("TicketStatusActor")
  customerHistory     CustomerHistoryEntry[] @relation("CustomerHistoryActor")
  auditEntries        AuditEntry[]           @relation("AuditActor")
  attachments         Attachment[]           @relation("AttachmentCreator")
  assignmentHistory   TicketAssignment[]     @relation("TicketAssignmentActor")

  @@map("users")
}

model Tenant {
  id                     String                 @id @default(uuid()) @db.Uuid
  slug                   String                 @unique(map: "tenants_slug_key") @db.VarChar(80)
  name                   String                 @db.VarChar(120)
  timeZone               String                 @default("Europe/Istanbul") @map("time_zone") @db.VarChar(80)
  status                 TenantStatus           @default(ACTIVE)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships            TenantMembership[]
  customers              Customer[]
  contacts               CustomerContact[]
  sessions               UserSession[]
  identityAudit          IdentityAuditEntry[]
  customerHistory        CustomerHistoryEntry[]
  ticketCounter          TenantTicketCounter?
  tickets                Ticket[]
  ticketComments         TicketComment[]
  ticketStatusHistory    TicketStatusHistory[]
  tags                   Tag[]
  ticketTags             TicketTag[]
  attachments            Attachment[]
  auditEntries           AuditEntry[]
  outboxMessages         OutboxMessage[]
  consumedMessages       ConsumedMessage[]
  notifications          Notification[]
  notificationDeliveries NotificationDelivery[]
  queues                 Queue[]
  ticketAssignments      TicketAssignment[]
  slaPolicy              SlaPolicy?
  ticketSlaStates        TicketSlaState[]

  @@map("tenants")
}

model Customer {
  id        String                 @id @default(uuid()) @db.Uuid
  tenantId  String                 @map("tenant_id") @db.Uuid
  name      String                 @db.VarChar(160)
  version   Int                    @default(1)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts  CustomerContact[]
  history   CustomerHistoryEntry[]

  @@unique([tenantId, id], map: "customers_tenant_id_id_key")
  @@index([tenantId, name], map: "customers_tenant_name_idx")
  @@map("customers")
}

model CustomerContact {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  customerId  String             @map("customer_id") @db.Uuid
  userId      String?            @map("user_id") @db.Uuid
  email       String             @db.VarChar(254)
  displayName String             @map("display_name") @db.VarChar(120)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer           @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberships TenantMembership[]
  tickets     Ticket[]

  @@unique([tenantId, id], map: "customer_contacts_tenant_id_id_key")
  @@unique([tenantId, email], map: "customer_contacts_tenant_email_key")
  @@unique([tenantId, userId], map: "customer_contacts_tenant_user_key")
  @@map("customer_contacts")
}

model TenantMembership {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  userId            String                 @map("user_id") @db.Uuid
  customerContactId String?                @map("customer_contact_id") @db.Uuid
  role              TenantRole
  status            MembershipStatus       @default(ACTIVE)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerContact   CustomerContact?       @relation(fields: [tenantId, customerContactId], references: [tenantId, id], onDelete: Restrict)
  sessions          UserSession[]
  queueMemberships  QueueMember[]
  assignedTickets   Ticket[]               @relation("TicketCurrentAssignee")
  assignmentFrom    TicketAssignment[]     @relation("TicketAssignmentFromAssignee")
  assignmentTo      TicketAssignment[]     @relation("TicketAssignmentToAssignee")
  assignmentCursors QueueAssignmentState[] @relation("QueueAssignmentCursor")
  notifications     Notification[]

  @@unique([tenantId, id], map: "tenant_memberships_tenant_id_id_key")
  @@unique([tenantId, userId], map: "tenant_memberships_tenant_user_key")
  @@unique([tenantId, userId, id], map: "tenant_memberships_tenant_user_id_key")
  @@index([userId, status], map: "tenant_memberships_user_status_idx")
  @@map("tenant_memberships")
}

model UserSession {
  id               String           @id @default(uuid()) @db.Uuid
  familyId         String           @map("family_id") @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  membershipId     String           @map("membership_id") @db.Uuid
  refreshTokenHash String           @unique(map: "user_sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Char(64)
  issuedAt         DateTime         @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime?        @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(3)
  revokeReason     String?          @map("revoke_reason") @db.VarChar(80)
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership       TenantMembership @relation(fields: [tenantId, userId, membershipId], references: [tenantId, userId, id], onDelete: Cascade)

  @@index([familyId, revokedAt], map: "user_sessions_family_revoked_idx")
  @@index([userId, revokedAt], map: "user_sessions_user_revoked_idx")
  @@map("user_sessions")
}

model IdentityAuditEntry {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  subjectType String   @map("subject_type") @db.VarChar(80)
  subjectId   String   @map("subject_id") @db.Uuid
  metadata    Json?
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       User     @relation("IdentityAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt], map: "identity_audit_tenant_occurred_idx")
  @@map("identity_audit_entries")
}

model CustomerHistoryEntry {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  subjectType String   @map("subject_type") @db.VarChar(40)
  subjectId   String   @map("subject_id") @db.Uuid
  changes     Json?
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  actor       User     @relation("CustomerHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, customerId, occurredAt], map: "customer_history_tenant_customer_occurred_idx")
  @@map("customer_history_entries")
}

model TenantTicketCounter {
  tenantId   String   @id @map("tenant_id") @db.Uuid
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_ticket_counters")
}

model Ticket {
  id                          String                @id @default(uuid()) @db.Uuid
  tenantId                    String                @map("tenant_id") @db.Uuid
  number                      Int
  requesterContactId          String                @map("requester_contact_id") @db.Uuid
  createdByUserId             String                @map("created_by_user_id") @db.Uuid
  reopenedFromTicketId        String?               @map("reopened_from_ticket_id") @db.Uuid
  subject                     String                @db.VarChar(200)
  description                 String                @db.Text
  status                      TicketStatus          @default(NEW)
  priority                    TicketPriority        @default(NORMAL)
  version                     Int                   @default(1)
  firstResponseAt             DateTime?             @map("first_response_at") @db.Timestamptz(3)
  resolvedAt                  DateTime?             @map("resolved_at") @db.Timestamptz(3)
  closedAt                    DateTime?             @map("closed_at") @db.Timestamptz(3)
  currentQueueId              String?               @map("current_queue_id") @db.Uuid
  currentAssigneeMembershipId String?               @map("current_assignee_membership_id") @db.Uuid
  assignedAt                  DateTime?             @map("assigned_at") @db.Timestamptz(3)
  createdAt                   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requesterContact            CustomerContact       @relation(fields: [tenantId, requesterContactId], references: [tenantId, id], onDelete: Restrict)
  createdBy                   User                  @relation("TicketCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reopenedFrom                Ticket?               @relation("TicketReopen", fields: [tenantId, reopenedFromTicketId], references: [tenantId, id], onDelete: Restrict)
  reopenedTickets             Ticket[]              @relation("TicketReopen")
  comments                    TicketComment[]
  statusHistory               TicketStatusHistory[]
  tags                        TicketTag[]
  attachments                 Attachment[]
  currentQueue                Queue?                @relation("TicketCurrentQueue", fields: [tenantId, currentQueueId], references: [tenantId, id], onDelete: Restrict)
  currentAssignee             TenantMembership?     @relation("TicketCurrentAssignee", fields: [tenantId, currentAssigneeMembershipId], references: [tenantId, id], onDelete: Restrict)
  assignmentHistory           TicketAssignment[]
  notifications               Notification[]
  slaState                    TicketSlaState?

  @@unique([tenantId, id], map: "tickets_tenant_id_id_key")
  @@unique([tenantId, number], map: "tickets_tenant_number_key")
  @@unique([tenantId, reopenedFromTicketId], map: "tickets_tenant_reopened_from_key")
  @@index([tenantId, status, updatedAt], map: "tickets_tenant_status_updated_idx")
  @@index([tenantId, requesterContactId, updatedAt], map: "tickets_tenant_requester_updated_idx")
  @@index([tenantId, priority, updatedAt], map: "tickets_tenant_priority_updated_idx")
  @@index([tenantId, currentQueueId, status, updatedAt], map: "tickets_tenant_queue_status_updated_idx")
  @@index([tenantId, currentAssigneeMembershipId, status, updatedAt], map: "tickets_tenant_assignee_status_updated_idx")
  @@map("tickets")
}

model Queue {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  name            String                @db.VarChar(120)
  description     String?               @db.VarChar(500)
  status          QueueStatus           @default(ACTIVE)
  version         Int                   @default(1)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members         QueueMember[]
  assignmentState QueueAssignmentState?
  currentTickets  Ticket[]              @relation("TicketCurrentQueue")
  assignmentFrom  TicketAssignment[]    @relation("TicketAssignmentFromQueue")
  assignmentTo    TicketAssignment[]    @relation("TicketAssignmentToQueue")

  @@unique([tenantId, id], map: "queues_tenant_id_id_key")
  @@unique([tenantId, name], map: "queues_tenant_name_key")
  @@index([tenantId, status, name], map: "queues_tenant_status_name_idx")
  @@map("queues")
}

model QueueMember {
  tenantId     String            @map("tenant_id") @db.Uuid
  queueId      String            @map("queue_id") @db.Uuid
  membershipId String            @map("membership_id") @db.Uuid
  status       QueueMemberStatus @default(ACTIVE)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  queue        Queue             @relation(fields: [tenantId, queueId], references: [tenantId, id], onDelete: Cascade)
  membership   TenantMembership  @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, queueId, membershipId])
  @@index([tenantId, membershipId, status], map: "queue_members_tenant_membership_status_idx")
  @@map("queue_members")
}

model QueueAssignmentState {
  tenantId                 String            @map("tenant_id") @db.Uuid
  queueId                  String            @map("queue_id") @db.Uuid
  lastAssignedMembershipId String?           @map("last_assigned_membership_id") @db.Uuid
  version                  Int               @default(0)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  queue                    Queue             @relation(fields: [tenantId, queueId], references: [tenantId, id], onDelete: Cascade)
  lastAssignedMembership   TenantMembership? @relation("QueueAssignmentCursor", fields: [tenantId, lastAssignedMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, queueId])
  @@map("queue_assignment_states")
}

model TicketAssignment {
  id                       String                 @id @default(uuid()) @db.Uuid
  tenantId                 String                 @map("tenant_id") @db.Uuid
  ticketId                 String                 @map("ticket_id") @db.Uuid
  actorUserId              String                 @map("actor_user_id") @db.Uuid
  action                   TicketAssignmentAction
  fromQueueId              String?                @map("from_queue_id") @db.Uuid
  toQueueId                String?                @map("to_queue_id") @db.Uuid
  fromAssigneeMembershipId String?                @map("from_assignee_membership_id") @db.Uuid
  toAssigneeMembershipId   String?                @map("to_assignee_membership_id") @db.Uuid
  version                  Int
  occurredAt               DateTime               @default(now()) @map("occurred_at") @db.Timestamptz(3)
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket                   Ticket                 @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  actor                    User                   @relation("TicketAssignmentActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  fromQueue                Queue?                 @relation("TicketAssignmentFromQueue", fields: [tenantId, fromQueueId], references: [tenantId, id], onDelete: Restrict)
  toQueue                  Queue?                 @relation("TicketAssignmentToQueue", fields: [tenantId, toQueueId], references: [tenantId, id], onDelete: Restrict)
  fromAssignee             TenantMembership?      @relation("TicketAssignmentFromAssignee", fields: [tenantId, fromAssigneeMembershipId], references: [tenantId, id], onDelete: Restrict)
  toAssignee               TenantMembership?      @relation("TicketAssignmentToAssignee", fields: [tenantId, toAssigneeMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, ticketId, version], map: "ticket_assignments_ticket_version_key")
  @@index([tenantId, ticketId, occurredAt], map: "ticket_assignments_tenant_ticket_occurred_idx")
  @@index([tenantId, toQueueId, occurredAt], map: "ticket_assignments_tenant_queue_occurred_idx")
  @@index([tenantId, toAssigneeMembershipId, occurredAt], map: "ticket_assignments_tenant_assignee_occurred_idx")
  @@map("ticket_assignments")
}

model TicketComment {
  id           String                  @id @default(uuid()) @db.Uuid
  tenantId     String                  @map("tenant_id") @db.Uuid
  ticketId     String                  @map("ticket_id") @db.Uuid
  authorUserId String                  @map("author_user_id") @db.Uuid
  visibility   TicketCommentVisibility
  body         String                  @db.Text
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket       Ticket                  @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  author       User                    @relation("TicketCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  attachments  Attachment[]

  @@unique([tenantId, id], map: "ticket_comments_tenant_id_id_key")
  @@index([tenantId, ticketId, createdAt], map: "ticket_comments_tenant_ticket_created_idx")
  @@map("ticket_comments")
}

model TicketStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  ticketId    String         @map("ticket_id") @db.Uuid
  actorType   AuditActorType @default(USER) @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  fromStatus  TicketStatus?  @map("from_status")
  toStatus    TicketStatus   @map("to_status")
  version     Int
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket         @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  actor       User?          @relation("TicketStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, ticketId, version], map: "ticket_status_history_ticket_version_key")
  @@index([tenantId, ticketId, occurredAt], map: "ticket_status_history_tenant_ticket_occurred_idx")
  @@map("ticket_status_history")
}

model Tag {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  name      String      @db.VarChar(60)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets   TicketTag[]

  @@unique([tenantId, id], map: "tags_tenant_id_id_key")
  @@unique([tenantId, name], map: "tags_tenant_name_key")
  @@map("tags")
}

model TicketTag {
  tenantId String @map("tenant_id") @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket   Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, ticketId, tagId])
  @@index([tenantId, tagId, ticketId], map: "ticket_tags_tenant_tag_ticket_idx")
  @@map("ticket_tags")
}

model Attachment {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  ticketId        String   @map("ticket_id") @db.Uuid
  commentId       String?  @map("comment_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  fileName        String   @map("file_name") @db.VarChar(255)
  contentType     String   @map("content_type") @db.VarChar(120)
  byteSize        BigInt   @map("byte_size")
  checksumSha256  String?  @map("checksum_sha256") @db.Char(64)
  storageKey      String   @map("storage_key") @db.VarChar(500)
  visibility      TicketCommentVisibility @default(PUBLIC)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket          Ticket   @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  comment         TicketComment? @relation(fields: [tenantId, commentId], references: [tenantId, id], onDelete: Cascade)
  createdBy       User     @relation("AttachmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id], map: "attachments_tenant_id_id_key")
  @@unique([tenantId, storageKey], map: "attachments_tenant_storage_key_key")
  @@index([tenantId, ticketId, createdAt], map: "attachments_tenant_ticket_created_idx")
  @@index([tenantId, commentId, createdAt], map: "attachments_tenant_comment_created_idx")
  @@map("attachments")
}

model AuditEntry {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  actorType     AuditActorType @default(USER) @map("actor_type")
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  action        String         @db.VarChar(100)
  aggregateType String         @map("aggregate_type") @db.VarChar(80)
  aggregateId   String         @map("aggregate_id") @db.Uuid
  metadata      Json?
  occurredAt    DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor         User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, aggregateType, aggregateId, occurredAt], map: "audit_entries_tenant_aggregate_occurred_idx")
  @@map("audit_entries")
}

model SlaPolicy {
  id                       String            @id @default(uuid()) @db.Uuid
  tenantId                 String            @unique(map: "sla_policies_tenant_id_key") @map("tenant_id") @db.Uuid
  version                  Int               @default(1)
  autoCloseResolvedMinutes Int               @map("auto_close_resolved_minutes")
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targets                  SlaPolicyTarget[]
  ticketStates             TicketSlaState[]

  @@unique([tenantId, id], map: "sla_policies_tenant_id_id_key")
  @@map("sla_policies")
}

model SlaPolicyTarget {
  tenantId                 String         @map("tenant_id") @db.Uuid
  policyId                 String         @map("policy_id") @db.Uuid
  priority                 TicketPriority
  firstResponseMinutes     Int            @map("first_response_minutes")
  resolutionMinutes        Int            @map("resolution_minutes")
  approachingBeforeMinutes Int            @map("approaching_before_minutes")
  policy                   SlaPolicy      @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, policyId, priority])
  @@map("sla_policy_targets")
}

model TicketSlaState {
  tenantId                         String             @map("tenant_id") @db.Uuid
  ticketId                         String             @map("ticket_id") @db.Uuid
  policyId                         String             @map("policy_id") @db.Uuid
  policyVersion                    Int                @map("policy_version")
  prioritySnapshot                 TicketPriority     @map("priority_snapshot")
  firstResponseMinutesSnapshot     Int                @map("first_response_minutes_snapshot")
  resolutionMinutesSnapshot        Int                @map("resolution_minutes_snapshot")
  approachingBeforeMinutesSnapshot Int                @map("approaching_before_minutes_snapshot")
  autoCloseResolvedMinutesSnapshot Int                @map("auto_close_resolved_minutes_snapshot")
  firstResponseDueAt               DateTime           @map("first_response_due_at") @db.Timestamptz(3)
  resolutionDueAt                  DateTime           @map("resolution_due_at") @db.Timestamptz(3)
  firstResponseApproachingAt       DateTime           @map("first_response_approaching_at") @db.Timestamptz(3)
  resolutionApproachingAt          DateTime           @map("resolution_approaching_at") @db.Timestamptz(3)
  firstResponseStatus              SlaMilestoneStatus @default(ACTIVE) @map("first_response_status")
  resolutionStatus                 SlaMilestoneStatus @default(ACTIVE) @map("resolution_status")
  firstResponseCompletedAt         DateTime?          @map("first_response_completed_at") @db.Timestamptz(3)
  resolutionCompletedAt            DateTime?          @map("resolution_completed_at") @db.Timestamptz(3)
  firstResponseApproachingSentAt   DateTime?          @map("first_response_approaching_sent_at") @db.Timestamptz(3)
  firstResponseBreachedAt          DateTime?          @map("first_response_breached_at") @db.Timestamptz(3)
  resolutionApproachingSentAt      DateTime?          @map("resolution_approaching_sent_at") @db.Timestamptz(3)
  resolutionBreachedAt             DateTime?          @map("resolution_breached_at") @db.Timestamptz(3)
  autoCloseAt                      DateTime?          @map("auto_close_at") @db.Timestamptz(3)
  version                          Int                @default(1)
  createdAt                        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket                           Ticket             @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  policy                           SlaPolicy          @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, ticketId])
  @@index([firstResponseStatus, firstResponseApproachingAt, firstResponseDueAt], map: "ticket_sla_first_response_due_idx")
  @@index([resolutionStatus, resolutionApproachingAt, resolutionDueAt], map: "ticket_sla_resolution_due_idx")
  @@index([autoCloseAt], map: "ticket_sla_auto_close_idx")
  @@map("ticket_sla_states")
}

model OutboxMessage {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  aggregateType String              @map("aggregate_type") @db.VarChar(80)
  aggregateId   String              @map("aggregate_id") @db.Uuid
  eventType     String              @map("event_type") @db.VarChar(120)
  schemaVersion Int                 @default(1) @map("schema_version")
  payload       Json
  correlationId String?             @map("correlation_id") @db.VarChar(128)
  causationId   String?             @map("causation_id") @db.VarChar(128)
  traceparent   String?             @db.VarChar(55)
  status        OutboxMessageStatus @default(PENDING)
  attempts      Int                 @default(0)
  availableAt   DateTime            @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedBy      String?             @map("locked_by") @db.VarChar(100)
  lockedUntil   DateTime?           @map("locked_until") @db.Timestamptz(3)
  occurredAt    DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime?           @map("published_at") @db.Timestamptz(3)
  lastErrorCode String?             @map("last_error_code") @db.VarChar(100)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, lockedUntil, occurredAt], map: "outbox_messages_status_available_idx")
  @@index([tenantId, aggregateType, aggregateId, occurredAt], map: "outbox_messages_tenant_aggregate_idx")
  @@map("outbox_messages")
}

model ConsumedMessage {
  consumerName String   @map("consumer_name") @db.VarChar(120)
  messageId    String   @map("message_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  eventType    String   @map("event_type") @db.VarChar(120)
  consumedAt   DateTime @default(now()) @map("consumed_at") @db.Timestamptz(3)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([consumerName, messageId])
  @@index([tenantId, consumedAt], map: "consumed_messages_tenant_consumed_idx")
  @@map("consumed_messages")
}

model Notification {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  recipientMembershipId String                 @map("recipient_membership_id") @db.Uuid
  ticketId              String?                @map("ticket_id") @db.Uuid
  sourceMessageId       String                 @map("source_message_id") @db.Uuid
  kind                  String                 @db.VarChar(100)
  payload               Json
  readAt                DateTime?              @map("read_at") @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient             TenantMembership       @relation(fields: [tenantId, recipientMembershipId], references: [tenantId, id], onDelete: Cascade)
  ticket                Ticket?                @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  deliveries            NotificationDelivery[]

  @@unique([tenantId, id], map: "notifications_tenant_id_id_key")
  @@unique([tenantId, recipientMembershipId, sourceMessageId, kind], map: "notifications_recipient_source_kind_key")
  @@index([tenantId, recipientMembershipId, readAt, createdAt], map: "notifications_recipient_unread_created_idx")
  @@map("notifications")
}

model NotificationDelivery {
  id               String                      @id @default(uuid()) @db.Uuid
  tenantId         String                      @map("tenant_id") @db.Uuid
  notificationId   String                      @map("notification_id") @db.Uuid
  channel          NotificationDeliveryChannel
  status           NotificationDeliveryStatus  @default(PENDING)
  attempts         Int                         @default(0)
  deduplicationKey String                      @map("deduplication_key") @db.VarChar(200)
  deliveredAt      DateTime?                   @map("delivered_at") @db.Timestamptz(3)
  lastErrorCode    String?                     @map("last_error_code") @db.VarChar(100)
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification     Notification                @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, deduplicationKey], map: "notification_deliveries_tenant_dedupe_key")
  @@index([tenantId, status, createdAt], map: "notification_deliveries_status_created_idx")
  @@map("notification_deliveries")
}
