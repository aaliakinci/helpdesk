{
  "name": "helpdesk-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant customer support platform portfolio project.",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "src/server/apps/*",
    "src/web"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "npm run prisma:generate && tsc -p src/server/tsconfig.build.json",
    "build:web": "npm run build --workspace @helpdesk/support-web",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node --enable-source-maps dist/server/prisma/seed.js",
    "dev": "docker compose up --build",
    "dev:api": "npm run build:server && npm run start:api",
    "dev:web": "npm run dev --workspace @helpdesk/support-web",
    "dev:worker": "npm run build:server && npm run start:worker",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "prisma:generate": "prisma generate",
    "smoke:services": "node scripts/verify-running-services.mjs",
    "smoke:identity": "node scripts/verify-auth-flow.mjs",
    "smoke:messaging": "node scripts/verify-messaging-flow.mjs",
    "smoke:operations": "node scripts/verify-operations-flow.mjs",
    "smoke:realtime": "node scripts/verify-realtime-flow.mjs",
    "smoke:support": "node scripts/verify-support-flow.mjs",
    "smoke:worker-shutdown": "node scripts/verify-worker-shutdown-flow.mjs",
    "start:api": "node --enable-source-maps dist/server/apps/support-api/src/main.js",
    "start:worker": "node --enable-source-maps dist/server/apps/support-worker/src/main.js",
    "test": "npm run test:unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e:accessibility": "playwright test tests/e2e/accessibility.spec.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "npm run prisma:generate && npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc -p src/server/tsconfig.json --noEmit",
    "typecheck:web": "npm run typecheck --workspace @helpdesk/support-web",
    "verify": "npm run verify:baseline && npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "verify:baseline": "node scripts/verify-repository-baseline.mjs",
    "verify:dependency-audit": "node scripts/verify-dependency-audit.mjs",
    "verify:migrations": "node scripts/verify-migrations-from-scratch.mjs",
    "verify:query-plans": "node scripts/verify-query-plans.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1117.0",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/platform-socket.io": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@socket.io/redis-adapter": "8.3.0",
    "amqplib": "2.0.1",
    "dotenv": "17.2.3",
    "file-type": "21.3.4",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.6",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aaliakinci/helpdesk.git"
  }
}
